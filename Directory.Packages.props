<Project>
  <ItemGroup>
    <PackageVersion Include="Autofac" Version="7.0.0" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
      <PackageVersion Include="GitInfo">
          <Version>2.3.0</Version>
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="7.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
    <PackageVersion Include="Mutagen.Bethesda" Version="0.40.0.1-dev" />
    <PackageVersion Include="Mutagen.Bethesda.Autofac" Version="0.40.0.1-dev" />
    <PackageVersion Include="Mutagen.Bethesda.Core" Version="0.40.0.1-dev" />
    <PackageVersion Include="Mutagen.Bethesda.Skyrim" Version="0.40.0.1-dev" />
    <PackageVersion Include="Mutagen.Bethesda.Testing">
      <Version>0.41.0.1-dev</Version>
    </PackageVersion>
      <PackageVersion Include="NuGetizer">
          <Version>0.9.1</Version>
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageVersion>
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
